# Mock OID4VC Issuer — environment configuration.
# Copy to `.env` and adjust as needed: `cp .env.example .env`
# All values below are optional; the defaults shown are what the server uses when unset.

# ---- Server ----
PORT=4000
HOST=0.0.0.0

# Public base URL the issuer advertises (e.g. a tunnel URL when testing a wallet).
# Defaults to https://mock-issuer.local:4000 when unset.
ISSUER_URL=https://mock-issuer.local:4000

# ---- TLS ----
# Most wallets require HTTPS. Set USE_HTTPS=false only when a proxy/tunnel already
# terminates TLS in front of this service (e.g. ngrok, cloudflared).
USE_HTTPS=true
TLS_KEY_PATH=cert/server.key
TLS_CERT_PATH=cert/server.cert

# ---- DPoP (RFC 9449) ----
# When true, the token endpoint returns 400 use_dpop_nonce on the first request,
# forcing the wallet to retry with a server-issued DPoP-Nonce (tests the retry flow).
USE_DPOP_NONCE=false

# ---- Credential signing ----
# LDP-VC signature suite: ed25519 (default) or rsa.
LDP_SIGNATURE_SUITE=ed25519

# ---- OVP verifier (Presentation During Issuance) ----
# Base URL of the OVP verifier backend the issuer calls during the PDI flow.
VERIFIER_BASE_URL=http://localhost:3000

# ---- Test-error injection (optional) ----
# Force the mock to return a specific error at a given stage, to exercise the
# wallet's error handling. Leave unset for normal operation.
# TEST_ERROR_STAGE: one of offer | authorization | token | credential | par
# TEST_ERROR_CODE:  e.g. invalid_token, invalid_grant, invalid_proof
# TEST_ERROR_STATUS: optional HTTP status override (400-599)
# TEST_ERROR_DESCRIPTION: optional custom error_description
#TEST_ERROR_STAGE=token
#TEST_ERROR_CODE=invalid_grant
#TEST_ERROR_STATUS=400
#TEST_ERROR_DESCRIPTION=
